rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email == "febriankusumaa@gmail.com";
    }
    function approved() {
      return signedIn()
        && get(/databases/$(database)/documents/izin/$(request.auth.uid)).data.status == "disetujui";
    }

    // Daftar izin: satu dokumen per akun Google (id = uid).
    match /izin/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == "menunggu"
        && request.resource.data.keys().hasOnly(["email", "nama", "foto", "status", "diminta", "terakhir", "posisi"]);
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["terakhir", "posisi"]));
      allow delete: if isOwner();
    }

    // Progres pribadi: soal yang pernah dijawab benar, hanya bisa dibaca dan ditulis pemiliknya sendiri.
    match /progres/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid && (isOwner() || approved());
    }

    // Bank soal: hanya bisa dibaca akun yang disetujui; hanya pemilik yang bisa mengunggah.
    match /bank/{doc} {
      allow read: if isOwner() || approved();
      allow write: if isOwner();
    }

    // Try Out bersama: siapa pun yang masuk dengan Google bisa membaca soal dan papan peringkat;
    // hanya pemilik yang membuat, memulai, dan mengakhiri. Peserta hanya menulis dokumennya sendiri selama try out berjalan.
    match /tryout/{id} {
      allow read: if signedIn();
      allow write: if isOwner();
      match /peserta/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["nama", "foto", "jawab", "benar", "dijawab", "skor", "dur", "selesai", "siap", "t"])
          && request.resource.data.skor is int && request.resource.data.skor >= 0 && request.resource.data.skor <= 100
          && get(/databases/$(database)/documents/tryout/$(id)).data.status in ["menunggu", "siap", "mulai"]
          && (resource == null || resource.data.selesai != true);
        allow delete: if isOwner();
      }
    }
  }
}
